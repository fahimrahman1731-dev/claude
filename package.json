{
  "name": "det-vocab-trainer",
  "private": true,
  "version": "1.0.0",
  "description": "Practice engine for Duolingo English Test reading vocabulary, spelling and word endings, built from the student's own study materials.",
  "type": "module",
  "scripts": {
    "extract": "tsx scripts/extract.ts",
    "build:data": "tsx scripts/build-vocab.ts",
    "predev": "npm run build:data",
    "dev": "vite",
    "build": "npm run build:data && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ai-proxy": "node server/ai-proxy.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "dexie": "4.0.11",
    "dexie-react-hooks": "1.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.0.1",
    "jsdom": "25.0.1",
    "tsx": "4.19.4",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "5.0.3"
  }
}
